{
	"name": "@revanta/anarcism",
	"version": "1.0.1",
	"description": "ANARCI-compatible IMGT numbering in WebAssembly for browsers and Node.js",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Revanta-Inc/anarcism.git",
		"directory": "packages/anarcism"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./worker-pool": {
			"types": "./dist/worker-pool.d.ts",
			"import": "./dist/worker-pool.js"
		},
		"./anarcism.wasm": "./dist/anarcism.wasm"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "../../tools/build-js.sh",
		"test": "node --test test/node.test.mjs",
		"test:browser": "playwright test",
		"test:types": "tsc --noEmit",
		"benchmark": "node bench/benchmark.mjs",
		"benchmark:browser": "node bench/browser-benchmark.mjs",
		"parity": "node ../../tools/parity-report.mjs",
		"size": "node ../../tools/size-report.mjs"
	},
	"devDependencies": {
		"@playwright/test": "1.62.1",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=20.16"
	}
}
